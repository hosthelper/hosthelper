// hosthelper 도메인 모델
// 참조: docs/prd/PRD.md, docs/adr/ADR-0001-stack-and-monorepo.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================
// Identity
// =========================================

enum UserRole {
  HOST
  CLEANER
  OPS_ADMIN
  OPS_AGENT
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  id            String     @id @default(cuid())
  phone         String     @unique
  email         String?    @unique
  name          String
  role          UserRole
  status        UserStatus @default(PENDING)
  passwordHash  String?
  phoneVerified Boolean    @default(false)
  emailVerified Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  hostProfile    HostProfile?
  cleanerProfile CleanerProfile?

  reviewsAuthored Review[] @relation("ReviewAuthor")
  reviewsReceived Review[] @relation("ReviewTarget")

  @@index([role, status])
}

model HostProfile {
  id           String     @id @default(cuid())
  userId       String     @unique
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName String?
  bizRegNo     String? // 사업자등록번호 (선택)
  proMember    Boolean    @default(false)
  proSince     DateTime?
  trustScore   Decimal    @default(0) @db.Decimal(5, 2)
  properties   Property[]
  bookings     Booking[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

model CleanerProfile {
  id              String        @id @default(cuid())
  userId          String        @unique
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio             String?
  yearsExperience Int           @default(0)
  baseLat         Decimal?      @db.Decimal(10, 7) // 활동 기준 위치
  baseLng         Decimal?      @db.Decimal(10, 7)
  serviceRadiusKm Int           @default(10)
  kycStatus       KycStatus     @default(NOT_SUBMITTED)
  kycSubmittedAt  DateTime?
  kycApprovedAt   DateTime?
  trustScore      Decimal       @default(0) @db.Decimal(5, 2)
  rating          Decimal       @default(0) @db.Decimal(3, 2) // 0.00 ~ 5.00
  ratingCount     Int           @default(0)
  completedJobs   Int           @default(0)
  rebookingRate   Decimal       @default(0) @db.Decimal(5, 4)
  declineRate     Decimal       @default(0) @db.Decimal(5, 4)
  active          Boolean       @default(true)
  skills          CleanerSkill[]
  availabilities  Availability[]
  jobs            CleaningJob[]
  payouts         Payout[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([baseLat, baseLng])
  @@index([active, kycStatus])
}

// =========================================
// Catalog
// =========================================

enum KeyHandover {
  LOCKBOX
  SMART_LOCK
  IN_PERSON
  FRONT_DESK
}

model Property {
  id              String           @id @default(cuid())
  hostId          String
  host            HostProfile      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  nickname        String
  addressLine1    String
  addressLine2    String?
  district        String // 강남구, 마포구 등
  postalCode      String
  lat             Decimal          @db.Decimal(10, 7)
  lng             Decimal          @db.Decimal(10, 7)
  pyeong          Decimal          @db.Decimal(5, 2) // 평수
  bedrooms        Int
  bathrooms       Int
  keyHandover     KeyHandover
  keyInstructions String?
  cleaningManual  String?          @db.Text
  active          Boolean          @default(true)
  checklistId     String?
  checklist       ChecklistTemplate? @relation(fields: [checklistId], references: [id])
  bookings        Booking[]
  pmsConfig       PmsPropertyConfig?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([hostId, active])
  @@index([lat, lng])
}

model Skill {
  id           String         @id @default(cuid())
  code         String         @unique // LINEN_CHANGE, DEEP_CLEAN, WINDOW, IRON ...
  label        String
  description  String?
  cleaners     CleanerSkill[]
}

model CleanerSkill {
  cleanerId String
  skillId   String
  level     Int            @default(1) // 1-5
  cleaner   CleanerProfile @relation(fields: [cleanerId], references: [id], onDelete: Cascade)
  skill     Skill          @relation(fields: [skillId], references: [id])

  @@id([cleanerId, skillId])
}

model ChecklistTemplate {
  id          String           @id @default(cuid())
  name        String
  description String?
  items       ChecklistItem[]
  properties  Property[]
  createdAt   DateTime         @default(now())
}

model ChecklistItem {
  id           String            @id @default(cuid())
  templateId   String
  template     ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  area         String // 거실, 침실1, 욕실 등
  title        String
  description  String?
  photoRequired Boolean          @default(true)
  orderIdx     Int

  @@index([templateId, orderIdx])
}

// =========================================
// Scheduling
// =========================================

model Availability {
  id        String         @id @default(cuid())
  cleanerId String
  cleaner   CleanerProfile @relation(fields: [cleanerId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  endsAt    DateTime

  @@index([cleanerId, startsAt])
}

enum BookingStatus {
  DRAFT
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Booking {
  id              String         @id @default(cuid())
  hostId          String
  host            HostProfile    @relation(fields: [hostId], references: [id])
  propertyId      String
  property        Property       @relation(fields: [propertyId], references: [id])
  cleaningStartAt DateTime
  cleaningEndAt   DateTime
  status          BookingStatus  @default(DRAFT)
  notes           String?
  quotedPrice     Int
  platformFee     Int
  cleanerPayout   Int
  job             CleaningJob?
  payment         Payment?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([hostId, cleaningStartAt])
  @@index([status])
}

enum JobStatus {
  REQUESTED
  MATCHED
  IN_PROGRESS
  SUBMITTED
  APPROVED
  SETTLED
  DISPUTED
  CANCELLED
}

model CleaningJob {
  id          String          @id @default(cuid())
  bookingId   String          @unique
  booking     Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  cleanerId   String?
  cleaner     CleanerProfile? @relation(fields: [cleanerId], references: [id])
  status      JobStatus       @default(REQUESTED)
  startedAt   DateTime?
  submittedAt DateTime?
  approvedAt  DateTime?
  disputedAt  DateTime?
  cancelledAt DateTime?

  matchCandidates MatchCandidate[]
  offerRounds     OfferRound[]
  checklistRuns   ChecklistRun[]
  photos          Photo[]
  reviews         Review[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status])
  @@index([cleanerId, status])
}

// =========================================
// Matching
// =========================================

model MatchCandidate {
  id             String      @id @default(cuid())
  jobId          String
  job            CleaningJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  cleanerId      String
  score          Decimal     @db.Decimal(6, 4)
  distanceKm     Decimal     @db.Decimal(6, 3)
  ratingScore    Decimal     @db.Decimal(6, 4)
  completedScore Decimal     @db.Decimal(6, 4)
  rebookingScore Decimal     @db.Decimal(6, 4)
  declinePenalty Decimal     @db.Decimal(6, 4)
  computedAt     DateTime    @default(now())

  @@unique([jobId, cleanerId])
  @@index([jobId, score])
}

enum OfferRoundStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

model OfferRound {
  id          String           @id @default(cuid())
  jobId       String
  job         CleaningJob      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  roundIdx    Int
  cleanerId   String
  status      OfferRoundStatus @default(PENDING)
  expiresAt   DateTime
  respondedAt DateTime?
  createdAt   DateTime         @default(now())

  @@index([jobId, roundIdx])
  @@index([cleanerId, status])
}

// =========================================
// Quality
// =========================================

model ChecklistRun {
  id          String            @id @default(cuid())
  jobId       String
  job         CleaningJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  templateId  String
  startedAt   DateTime?
  completedAt DateTime?
  results     ChecklistResult[]
}

model ChecklistResult {
  id        String       @id @default(cuid())
  runId     String
  run       ChecklistRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  itemId    String
  checked   Boolean      @default(false)
  note      String?
  photoIds  String[]     @default([])
  checkedAt DateTime?

  @@unique([runId, itemId])
}

model Photo {
  id         String      @id @default(cuid())
  jobId      String
  job        CleaningJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  s3Key      String
  area       String?
  kind       String
  width      Int?
  height     Int?
  takenAt    DateTime?
  uploadedAt DateTime    @default(now())

  @@index([jobId, kind])
}

model Review {
  id        String      @id @default(cuid())
  jobId     String
  job       CleaningJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  authorId  String
  author    User        @relation("ReviewAuthor", fields: [authorId], references: [id])
  targetId  String
  target    User        @relation("ReviewTarget", fields: [targetId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime    @default(now())

  @@unique([jobId, authorId])
  @@index([targetId])
}

// =========================================
// Money
// =========================================

model PricingRule {
  id               String   @id @default(cuid())
  name             String
  district         String?
  baseFee          Int
  perPyeong        Int
  bedroomAdd       Int
  nightSurcharge   Decimal  @default(1.0) @db.Decimal(4, 2)
  holidaySurcharge Decimal  @default(1.0) @db.Decimal(4, 2)
  dynamicCoef      Decimal  @default(1.0) @db.Decimal(4, 2)
  active           Boolean  @default(true)
  effectiveFrom    DateTime @default(now())
  effectiveTo      DateTime?

  @@index([district, active])
}

enum PaymentStatus {
  READY
  IN_PROGRESS
  PAID
  PARTIAL_CANCELED
  CANCELED
  FAILED
  EXPIRED
}

model Payment {
  id             String        @id @default(cuid())
  bookingId      String        @unique
  booking        Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  pgProvider     String        @default("toss")
  pgPaymentKey   String?       @unique
  orderId        String        @unique
  amount         Int
  status         PaymentStatus @default(READY)
  method         String?
  approvedAt     DateTime?
  cancelledAt    DateTime?
  failureCode    String?
  failureMessage String?
  rawResponse    Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
}

enum PayoutStatus {
  SCHEDULED
  HOLDING
  RELEASED
  PAID
  FAILED
  HOLD_ON_DISPUTE
}

model Payout {
  id             String         @id @default(cuid())
  cleanerId      String
  cleaner        CleanerProfile @relation(fields: [cleanerId], references: [id])
  jobId          String         @unique
  gross          Int
  platformFee    Int
  withholdingTax Int
  net            Int
  status         PayoutStatus   @default(SCHEDULED)
  scheduledFor   DateTime
  releasedAt     DateTime?
  paidAt         DateTime?
  bankCode       String?
  bankAccount    String?
  failureReason  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, scheduledFor])
}

model MatchingWeights {
  id              String   @id @default("default")
  wDistance       Decimal  @default(0.35) @db.Decimal(4, 3)
  wRating         Decimal  @default(0.25) @db.Decimal(4, 3)
  wCompleted      Decimal  @default(0.15) @db.Decimal(4, 3)
  wRebooking      Decimal  @default(0.15) @db.Decimal(4, 3)
  wDeclinePenalty Decimal  @default(0.10) @db.Decimal(4, 3)
  newCleanerBoost Decimal  @default(0.10) @db.Decimal(4, 3)
  maxDistanceKm   Int      @default(10)
  topN            Int      @default(5)
  offerTtlMinutes Int      @default(15)
  maxRounds       Int      @default(3)
  updatedAt       DateTime @updatedAt
}

enum DecisionKind {
  DISPUTE_TRIAGE
  PRICING_OVERRIDE
  MATCHING_WEIGHT_CHANGE
  CLEANER_KYC
  PAYOUT_HOLD_RELEASE
  POLICY_CHANGE
}

enum DecisionMaker {
  AI
  OPS_HUMAN
  HOST
  CLEANER
  SYSTEM
}

enum DecisionStatus {
  PROPOSED
  APPROVED
  OVERRIDDEN
  EXECUTED
  ROLLED_BACK
}

model Decision {
  id          String         @id @default(cuid())
  kind        DecisionKind
  subjectType String
  subjectId   String
  proposedBy  DecisionMaker
  decidedBy   DecisionMaker?
  status      DecisionStatus @default(PROPOSED)
  summary     String         @db.Text
  payload     Json
  confidence  Decimal?       @db.Decimal(4, 3)
  llmCallId   String?        @unique
  llmCall     LLMCall?       @relation(fields: [llmCallId], references: [id])
  createdAt   DateTime       @default(now())
  decidedAt   DateTime?
  executedAt  DateTime?

  @@index([kind, status, createdAt])
  @@index([subjectType, subjectId])
}

model LLMCall {
  id                       String    @id @default(cuid())
  purpose                  String
  model                    String
  inputTokens              Int
  outputTokens             Int
  cacheCreationInputTokens Int       @default(0)
  cacheReadInputTokens     Int       @default(0)
  costUsdMicro             Int
  latencyMs                Int
  success                  Boolean   @default(true)
  errorMessage             String?
  createdAt                DateTime  @default(now())

  decision Decision?

  @@index([purpose, createdAt])
  @@index([model, createdAt])
}

enum OperationType {
  DIRECT
  FULL_AUTO
  CONSIGNMENT
  FRANCHISE_HQ
}

enum StoreListingStatus {
  ACTIVE
  RESERVED
  SOLD
}

enum LeadStatus {
  NEW
  CONTACTED
  MEETING_SET
  CLOSED
}

enum ContactChannel {
  PHONE
  SMS
  KAKAO
}

model StoreListing {
  id            String             @id @default(cuid())
  title         String
  description   String?            @db.Text
  industry      String
  region        String
  operationType OperationType
  deposit       Int
  monthlyRent   Int
  premium       Int
  status        StoreListingStatus @default(ACTIVE)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([status, region])
}

model BuyerLead {
  id             String          @id @default(cuid())
  name           String
  phone          String
  contactChannel ContactChannel  @default(PHONE)
  operationTypes OperationType[] @default([])
  industries     String[]        @default([])
  regions        String[]        @default([])
  depositMax     Int?
  rentMax        Int?
  premiumMax     Int?
  notes          String?         @db.Text
  status         LeadStatus      @default(NEW)
  phoneAt        DateTime?
  visitAt        DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([phoneAt])
  @@index([visitAt])
}

// =========================================
// PMS Core W2 — lodging source of truth
// =========================================

enum PmsReservationStatus {
  DRAFT
  HELD
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum PmsReservationSource {
  DIRECT
  BOOKING_ENGINE
  AIRBNB
  BOOKING_COM
  AGODA
  EXPEDIA
  NAVER
  MANUAL
  OTHER
}

enum PmsRoomUnitStatus {
  ACTIVE
  OUT_OF_ORDER
  INACTIVE
}

enum PmsInventoryStopSellReason {
  NONE
  MANUAL
  MAINTENANCE
  SOLD_OUT
  CHANNEL_SYNC
}

enum PmsReservationEventType {
  CREATED
  HELD
  CONFIRMED
  MODIFIED
  CANCELLED
  CHECKED_IN
  CHECKED_OUT
  NO_SHOW
  INVENTORY_ALLOCATED
  INVENTORY_RELEASED
  CHANNEL_SYNCED
}

model PmsPropertyConfig {
  id            String   @id @default(cuid())
  propertyId    String   @unique
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  timezone      String   @default("Asia/Seoul")
  currency      String   @default("KRW")
  checkInTime   String   @default("15:00")
  checkOutTime  String   @default("11:00")
  active        Boolean  @default(true)
  roomTypes     PmsRoomType[]
  reservations  PmsReservation[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PmsRoomType {
  id                  String                @id @default(cuid())
  pmsPropertyConfigId String
  pmsPropertyConfig   PmsPropertyConfig     @relation(fields: [pmsPropertyConfigId], references: [id], onDelete: Cascade)
  code                String
  name                String
  baseOccupancy       Int
  maxOccupancy        Int
  defaultInventory    Int
  active              Boolean               @default(true)
  roomUnits           PmsRoomUnit[]
  reservations        PmsReservation[]
  reservationNights   PmsReservationNight[]
  inventoryDays       PmsInventoryDay[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@unique([pmsPropertyConfigId, code])
  @@index([pmsPropertyConfigId, active])
}

model PmsRoomUnit {
  id                String                @id @default(cuid())
  roomTypeId        String
  roomType          PmsRoomType           @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  code              String
  name              String?
  floor             String?
  status            PmsRoomUnitStatus     @default(ACTIVE)
  reservationNights PmsReservationNight[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([roomTypeId, code])
  @@index([roomTypeId, status])
}

model PmsGuest {
  id           String           @id @default(cuid())
  name         String
  email        String?
  phone        String?
  nationality  String?
  notes        String?          @db.Text
  reservations PmsReservation[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([phone])
  @@index([email])
}

model PmsReservation {
  id                    String               @id @default(cuid())
  pmsPropertyConfigId   String
  pmsPropertyConfig     PmsPropertyConfig    @relation(fields: [pmsPropertyConfigId], references: [id])
  roomTypeId            String
  roomType              PmsRoomType          @relation(fields: [roomTypeId], references: [id])
  primaryGuestId        String?
  primaryGuest          PmsGuest?            @relation(fields: [primaryGuestId], references: [id])
  source                PmsReservationSource @default(MANUAL)
  externalReservationId String?
  status                PmsReservationStatus @default(DRAFT)
  checkInDate           DateTime             @db.Date
  checkOutDate          DateTime             @db.Date
  adults                Int                  @default(1)
  children              Int                  @default(0)
  totalAmount           Int?
  currency              String               @default("KRW")
  notes                 String?              @db.Text
  version               Int                  @default(1)
  nights                PmsReservationNight[]
  events                PmsReservationEvent[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([pmsPropertyConfigId, checkInDate, checkOutDate])
  @@index([roomTypeId, status])
}

model PmsReservationNight {
  id                String         @id @default(cuid())
  reservationId     String
  reservation       PmsReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  stayDate          DateTime       @db.Date
  roomTypeId        String
  roomType          PmsRoomType    @relation(fields: [roomTypeId], references: [id])
  roomUnitId        String?
  roomUnit          PmsRoomUnit?   @relation(fields: [roomUnitId], references: [id])
  occupiesInventory Boolean        @default(true)
  nightlyRate       Int?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([reservationId, stayDate])
  @@index([roomTypeId, stayDate])
}

model PmsInventoryDay {
  id             String                     @id @default(cuid())
  roomTypeId     String
  roomType       PmsRoomType                @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  inventoryDate  DateTime                   @db.Date
  totalUnits     Int
  heldUnits      Int                        @default(0)
  soldUnits      Int                        @default(0)
  stopSell       Boolean                    @default(false)
  stopSellReason PmsInventoryStopSellReason @default(NONE)
  version        Int                        @default(1)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@unique([roomTypeId, inventoryDate])
  @@index([inventoryDate, stopSell])
}

model PmsReservationEvent {
  id             String                  @id @default(cuid())
  reservationId  String
  reservation    PmsReservation          @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  eventType      PmsReservationEventType
  actorType      String                  @default("SYSTEM")
  actorId        String?
  source         String?
  idempotencyKey String?
  payload        Json                    @default("{}")
  createdAt      DateTime                @default(now())

  @@index([reservationId, createdAt])
}